# Absolute origin used for canonical URLs, Open Graph tags and the sitemap.
# Leave unset for local work; set it to the preview or production domain when deploying.
NEXT_PUBLIC_SITE_URL=

# Search indexing is off by default: this is an unofficial concept and must not
# compete with the brand's own site. Set to "true" only after the owner approves
# a production launch. See docs/DEPLOYMENT-GUIDE.md.
NEXT_PUBLIC_ALLOW_INDEXING=false
